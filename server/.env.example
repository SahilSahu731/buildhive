# Runtime: serve /api through the same public origin as the web app.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
SERVER_URL=http://localhost:3000
TRUST_PROXY_HOPS=1
SESSION_SECRET=

# Supabase PostgreSQL. Runtime pooler uses transaction mode with pgbouncer=true.
# Keep SSL enabled for hosted databases. Never put these values in NEXT_PUBLIC variables.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=require

# Existing OAuth app credentials can be retained. Register these exact public callbacks.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Independent durable worker and Redis.
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=2
# 32-byte encryption key: openssl rand -hex 32. Back it up securely.
SECRETS_ENCRYPTION_KEY=
# HTTPS CONNECT proxy that resolves and pins public addresses. Mandatory in production.
RUNNER_EGRESS_PROXY=http://127.0.0.1:3128
EGRESS_PORT=3128
# Optional local Chrome installation; leave empty to use installed Playwright Chromium.
PLAYWRIGHT_CHANNEL=

# Private Supabase Storage bucket. Service role key is backend-only.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=buildhive-artifacts

# Optional AI features. Saved manual tests never require AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Transactional email. Use SMTP, or EMAIL_USER/EMAIL_PASS for a Gmail app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASS=

# Razorpay recurring subscription plans; use test-mode keys during validation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_GROWTH_PLAN_ID=

# Tests only: always point at an isolated disposable PostgreSQL database.
TEST_DATABASE_URL=
RUN_BROWSER_TESTS=0
