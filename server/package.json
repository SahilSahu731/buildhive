{
  "name": "buildhive-api",
  "version": "1.0.0",
  "description": "BuildHive browser testing API and worker",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx src/hive/worker.ts",
    "worker:start": "node dist/hive/worker.js",
    "typecheck": "tsc --noEmit",
    "db:deploy": "prisma migrate deploy",
    "egress": "tsx src/hive/egress.ts",
    "egress:start": "node dist/hive/egress.js"
  },
  "keywords": [
    "express",
    "api",
    "devcollab"
  ],
  "author": "Sahil Sahu",
  "license": "MIT",
  "dependencies": {
    "@playwright/test": "^1.64.0",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.117.3",
    "bullmq": "^6.3.11",
    "cors": "^2.8.5",
    "cron-parser": "^5.10.1",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.8.2",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.0.16",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "razorpay": "^2.9.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^25.0.10",
    "@types/nodemailer": "^7.0.9",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "prisma": "^6.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
