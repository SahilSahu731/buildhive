generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  Boolean   @default(false)
  password       String?
  image          String?
  githubId       String?   @unique
  githubUsername String?   @unique
  githubUrl      String?
  googleId       String?   @unique
  bio            String?   @db.Text
  skillLevel     SkillLevel?
  goal           String?
  preferredStack String?
  onboardingCompleted Boolean @default(false)
  skills         String[]
  availability   String?
  timezone       String?
  role           String    @default("user")
  
  hiveWorkspace HiveWorkspace?
  hiveSessions HiveSession[]

  // Subscription
  plan                   Plan      @default(FREE)
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  subscriptionStatus     String?   // active, past_due, etc.
  subscriptionEndDate    DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  projects       Project[]
  interests      Interest[]
  feedbacks      Feedback[]
  roadmaps       Roadmap[]
  progressEvents ProgressEvent[]
  usageQuotas    UsageQuota[]
  workflowBookmarks WorkflowBookmark[]
  workflowStepProgress WorkflowStepProgress[]
  promptTemplateFavorites PromptTemplateFavorite[]
  promptTemplateUsages PromptTemplateUsage[]
  
  @@index([email])
  @@index([githubId])
  @@index([googleId])
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Plan {
  FREE
  PREMIUM
  PRO
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String?
  type        String   // BUG, FEEDBACK, FEATURE_REQUEST
  title       String
  description String   @db.Text
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  rating      Int?
  createdAt   DateTime @default(now())
  
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([status])
  @@index([type])
}

model Announcement {
  id          String   @id @default(cuid())
  type        String   @default("BANNER") // BANNER, POPUP
  message     String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isActive])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  techStack   String[]
  lookingFor  String
  status      String   @default("open")
  
  // Rich content
  images      String[]
  demoUrl     String?
  repoUrl     String?
  difficulty  String   @default("Intermediate")
  category    String   @default("Web Development")
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests   Interest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model Interest {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  status    String   @default("pending")
  message   String?  @db.Text
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model Otp {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Workflow {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  summary          String
  category         String
  useCase          String
  difficulty       SkillLevel
  estimatedMinutes Int            @default(30)
  tags             String[]
  isPublished      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  steps            WorkflowStep[]
  promptPacks      PromptPack[]
  roadmaps         Roadmap[]
  progressEvents   ProgressEvent[]
  bookmarks        WorkflowBookmark[]
  stepProgress     WorkflowStepProgress[]

  @@index([category])
  @@index([difficulty])
  @@index([isPublished])
}

model WorkflowStep {
  id          String   @id @default(cuid())
  workflowId  String
  stepOrder   Int
  title       String
  description String   @db.Text
  promptHint  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  progress    WorkflowStepProgress[]

  @@unique([workflowId, stepOrder])
  @@index([workflowId])
}

model PromptPack {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String           @db.Text
  targetTool     String
  isPublished    Boolean          @default(false)
  tags           String[]
  workflowId     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  workflow       Workflow?        @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  templates      PromptTemplate[]
  progressEvents ProgressEvent[]

  @@index([targetTool])
  @@index([isPublished])
}

model PromptTemplate {
  id           String     @id @default(cuid())
  promptPackId String
  title        String
  description  String?    @db.Text
  content      String     @db.Text
  variables    Json?
  goodExample  String?    @db.Text
  badExample   String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  promptPack   PromptPack @relation(fields: [promptPackId], references: [id], onDelete: Cascade)
  favorites    PromptTemplateFavorite[]
  usages       PromptTemplateUsage[]

  @@index([promptPackId])
}

model WorkflowBookmark {
  id         String   @id @default(cuid())
  userId     String
  workflowId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([userId, workflowId])
  @@index([userId])
  @@index([workflowId])
}

model WorkflowStepProgress {
  id           String       @id @default(cuid())
  userId       String
  workflowId   String
  stepId       String
  isCompleted  Boolean      @default(false)
  lastVisitedAt DateTime    @default(now())
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  step         WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([userId, workflowId])
  @@index([stepId])
}

model PromptTemplateFavorite {
  id               String         @id @default(cuid())
  userId           String
  promptTemplateId String
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptTemplate   PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)

  @@unique([userId, promptTemplateId])
  @@index([userId])
  @@index([promptTemplateId])
}

model PromptTemplateUsage {
  id               String         @id @default(cuid())
  userId           String
  promptTemplateId String
  actionType       String
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptTemplate   PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([promptTemplateId])
  @@index([actionType])
}

model Roadmap {
  id              String          @id @default(cuid())
  userId          String
  workflowId      String?
  title           String
  goal            String
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow        Workflow?       @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  weeks           RoadmapWeek[]
  progressEvents  ProgressEvent[]

  @@index([userId])
  @@index([isActive])
}

model RoadmapWeek {
  id          String       @id @default(cuid())
  roadmapId   String
  weekNumber  Int
  title       String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  roadmap     Roadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks       RoadmapTask[]

  @@unique([roadmapId, weekNumber])
  @@index([roadmapId])
}

model RoadmapTask {
  id            String      @id @default(cuid())
  roadmapWeekId String
  title         String
  description   String?     @db.Text
  isCompleted   Boolean     @default(false)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  roadmapWeek   RoadmapWeek @relation(fields: [roadmapWeekId], references: [id], onDelete: Cascade)

  @@index([roadmapWeekId])
  @@index([isCompleted])
}

model ProgressEvent {
  id            String     @id @default(cuid())
  userId        String
  eventType     String
  workflowId    String?
  promptPackId  String?
  roadmapId     String?
  metadata      Json?
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow      Workflow?  @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  promptPack    PromptPack? @relation(fields: [promptPackId], references: [id], onDelete: SetNull)
  roadmap       Roadmap?   @relation(fields: [roadmapId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

model UsageQuota {
  id            String   @id @default(cuid())
  userId        String
  quotaDate     DateTime
  actionType    String
  usedCount     Int      @default(0)
  limitCount    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, quotaDate, actionType])
  @@index([userId])
  @@index([quotaDate])
}

// V1 testing product. Legacy tables remain intact during the migration.
model HiveSession {
  id String @id
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  data Json
  expiresAt DateTime
  @@index([expiresAt])
}
model HiveWorkspace {
  id String @id @default(uuid())
  ownerId String @unique
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String @default("My workspace")
  plan String @default("FREE")
  suspended Boolean @default(false)
  emailAlerts Boolean @default(true)
  recoveryAlerts Boolean @default(true)
  customerId String? @unique
  subscriptionId String? @unique
  subscriptionStatus String @default("free")
  periodEnd DateTime?
  billingEventAt BigInt @default(0)
  createdAt DateTime @default(now())
  projects HiveProject[]
  usage HiveUsage[]
  audit HiveAudit[]
}
model HiveProject {
  id String @id @default(uuid())
  workspaceId String
  workspace HiveWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  url String
  environment String @default("production")
  status String @default("unverified")
  verificationToken String @unique
  verifiedAt DateTime?
  verificationExpiresAt DateTime
  webhookSecret String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tests HiveTest[]
  secrets HiveSecret[]
  runs HiveRun[]
  deployments HiveDeployment[]
  @@index([workspaceId, createdAt])
}
model HiveTest {
  id String @id @default(uuid())
  projectId String
  project HiveProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name String
  description String @default("")
  status String @default("active")
  tags String[]
  currentVersion Int @default(1)
  deploymentEnabled Boolean @default(false)
  alertState String @default("healthy")
  alertRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions HiveTestVersion[]
  runs HiveRun[]
  schedule HiveSchedule?
  @@index([projectId, status])
}
model HiveTestVersion {
  id String @id @default(uuid())
  testId String
  test HiveTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  number Int
  definition Json
  createdAt DateTime @default(now())
  runs HiveRun[]
  @@unique([testId, number])
}
model HiveSecret {
  id String @id @default(uuid())
  projectId String
  project HiveProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name String
  encryptedValue String
  updatedAt DateTime @updatedAt
  @@unique([projectId, name])
}
model HiveRun {
  id String @id @default(uuid())
  projectId String
  project HiveProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testId String
  test HiveTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  versionId String
  version HiveTestVersion @relation(fields: [versionId], references: [id])
  status String @default("queued")
  trigger String @default("manual")
  deploymentId String?
  retryOf String?
  attempt Int @default(0)
  targetUrl String
  testName String
  environment String
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  heartbeatAt DateTime?
  alertProcessedAt DateTime?
  durationMs Int?
  error String?
  consoleErrors Json @default("[]")
  networkErrors Json @default("[]")
  explanation Json?
  steps HiveRunStep[]
  artifacts HiveArtifact[]
  notifications HiveNotification[]
  @@index([projectId, createdAt])
  @@index([testId, status, createdAt])
  @@index([status, heartbeatAt])
}
model HiveRunStep {
  id String @id @default(uuid())
  runId String
  run HiveRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  position Int
  action String
  status String
  durationMs Int @default(0)
  expected String?
  actual String?
  error String?
  @@unique([runId, position])
}
model HiveArtifact {
  id String @id @default(uuid())
  runId String
  run HiveRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind String
  path String @unique
  size Int
  expiresAt DateTime
  @@index([expiresAt])
}
model HiveSchedule {
  id String @id @default(uuid())
  testId String @unique
  test HiveTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  enabled Boolean @default(true)
  frequency String @default("daily")
  hour Int @default(9)
  timezone String @default("UTC")
  nextRunAt DateTime
  lastError String?
  @@index([enabled, nextRunAt])
}
model HiveUsage {
  id String @id @default(uuid())
  workspaceId String
  workspace HiveWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind String
  units Int @default(1)
  reference String? @unique
  createdAt DateTime @default(now())
  @@index([workspaceId, kind, createdAt])
}
model HiveNotification {
  id String @id @default(uuid())
  runId String
  run HiveRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind String
  status String @default("pending")
  attempts Int @default(0)
  lastAttemptAt DateTime?
  error String?
  createdAt DateTime @default(now())
  @@unique([runId, kind])
  @@index([status, createdAt])
}
model HiveDeployment {
  id String @id @default(uuid())
  projectId String
  project HiveProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventId String
  label String?
  createdAt DateTime @default(now())
  @@unique([projectId, eventId])
}
model HiveBillingEvent {
  id String @id
  createdAt DateTime @default(now())
}
model HiveAudit {
  id String @id @default(uuid())
  workspaceId String
  workspace HiveWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  action String
  resourceId String?
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}

model HiveServiceHealth {
  id String @id
  kind String
  lastSeenAt DateTime
  metadata Json
  @@index([kind, lastSeenAt])
}
