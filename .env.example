# Leave these empty for the local demonstration. Copy this file to .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set your canonical public origin for deployment, e.g. https://buildwithme.com.
# Leave empty in local development to use the incoming Host header.
APP_URL=

# Resend delivers OTP emails through Supabase custom SMTP.
# Configure the Resend API key in Supabase SMTP settings, not in this app.
# Never expose a Supabase service-role/secret key as a NEXT_PUBLIC variable.
