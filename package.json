{
  "name": "buildhive",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm --prefix client run dev",
    "dev:api": "npm --prefix server run dev",
    "dev:worker": "npm --prefix server run worker",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "test": "npm --prefix server test",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run typecheck",
    "db:generate": "npm --prefix server run prisma:generate",
    "db:deploy": "npm --prefix server run db:deploy",
    "check:config": "node infra/check-config.mjs"
  },
  "engines": {"node": ">=22.12"}
}
